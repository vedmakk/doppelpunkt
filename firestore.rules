rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/doc/{docId} {
      // Allow reads to only the two known docs for the authenticated user
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && (docId == 'editor' || docId == 'todo');

      // Allow writes only to the known docs and validate the schema
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (docId == 'editor' || docId == 'todo')
                   // Validate required fields
                   && request.resource.data.text is string
                   // Validate optional fields if present
                   && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
                   && (!('structuredTodos' in request.resource.data) || request.resource.data.structuredTodos is list)
                   && (!('structuredTodosProcessedAt' in request.resource.data) || request.resource.data.structuredTodosProcessedAt is timestamp)
                   && (!('structuredTodosError' in request.resource.data) || request.resource.data.structuredTodosError is string)
                   // Allow rev field for backward compatibility but don't require it
                   && (!('rev' in request.resource.data) || request.resource.data.rev is int)
                   // Ensure no unexpected fields (allow only known fields)
                   && request.resource.data.keys().hasAll(['text'])
                   && request.resource.data.keys().hasOnly(['text', 'rev', 'updatedAt', 'structuredTodos', 'structuredTodosProcessedAt', 'structuredTodosError']);

      // Allow deletes only to the known docs and authenticated user
      allow delete: if request.auth != null
                   && request.auth.uid == userId
                   && (docId == 'editor' || docId == 'todo');
    }

    // Rules for structured todos settings
    match /users/{userId}/settings/structuredTodos {
      // Allow reads for the authenticated user
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Allow writes for the authenticated user with proper schema validation
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Validate that only expected fields are present
                   && request.resource.data.keys().hasOnly(['enabled', 'apiKey'])
                   // enabled must be a boolean
                   && request.resource.data.enabled is bool
                   // apiKey is optional but must be a string if present
                   && (!('apiKey' in request.resource.data) || request.resource.data.apiKey is string);

      // Allow deletes for the authenticated user
      allow delete: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Rules for structured todos data (synced todos + hash)
    match /users/{userId}/structuredTodos/data {
      // Allow reads for the authenticated user
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Allow writes for the authenticated user with proper schema validation
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Validate required fields
                   && request.resource.data.todos is list
                   && request.resource.data.contentHash is string
                   // Validate optional fields if present
                   && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
                   // Ensure no unexpected fields
                   && request.resource.data.keys().hasOnly(['todos', 'contentHash', 'updatedAt']);

      // Allow deletes for the authenticated user
      allow delete: if request.auth != null
                   && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow deletes only for the authenticated user
      allow delete: if request.auth != null
                   && request.auth.uid == userId;
    }
  }
}
